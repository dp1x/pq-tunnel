# ============================================================
# Tunnel Project - Git Hygiene
# ============================================================

# ---- Build artifacts ----
target/
**/target/

# Fuzz runtime outputs / lock (volatile deps; not pinned for release)
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock

# Native compilation outputs that may escape target/
*.o
*.obj
*.lib
*.exp
*.dll
*.so
*.dylib
*.a
*.pdb
*.ilk
*.exe

# ---- Local / environment toolchain config ----
# `.cargo/config.toml` is a local override; the portable template is
# `.cargo/config.toml.example`. Do NOT commit your local config.
# (Use `.cargo/*` — not `.cargo/` — so the `.example` negation can match.)
.cargo/*
.cargo/config.toml
!.cargo/config.toml.example

# ---- Environment / Secrets ----
.env
.env.*
*.secret
*.secret.key
credentials.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.asc
*.gpg

config/prod*.*
config/*.secret

# ---- Agent / AI runtime & internal process files ----
# Internal agent workflow state is NOT part of the public release.
# AGENTS.md is intentionally public: it is contributor governance
# (coding rules, testing requirements, security rules).
.agent-summary.md
checkpoints/
docs/internal/
docs/superpowers/
internal/

*.private.md

ARCHITECTURE_REVIEW.md
AGENT_CONTEXT.md
AGENT_STATE.md
BLUEPRINT.md
CHECKPOINT.md
HYGIENE.md
handoff-*.md
session-state.md

# Private (internal) project documents
post_quantum_tunnel_blueprint.md
ARCHITECTURE.md
PROTOCOL.md

# ---- Machine / IDE ----
.DS_Store
.vscode/
.idea/
*.swp
*~

# ---- Local scripts / experiments (not part of the release) ----
install_arm64_tools.ps1
test_flatline.ps1

# ============================================================
# Public Documentation Exception
# ============================================================
# README.md, LICENSE-*, and the public design docs are intended for the
# public repository. Everything below that is NOT matched by an ignore rule
# is eligible to be committed.
